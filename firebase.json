{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "lib/functions"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1"
    },
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "app",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "functions": {
        "host": "127.0.0.1"
    },
    "firestore": {
        "host": "127.0.0.1"
    },
    "ui": {
        "enabled": true,
        "host": "127.0.0.1"
    }
  }
}
