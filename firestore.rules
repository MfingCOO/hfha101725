rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================== HELPERS ======================
    function isCoach(userId) {
      return userId in ['yue7fVPBQZg45vmfXXUH5PdG7jE2', 'oYsf7Iah6hVlEgHvWJ7Ms7j1oTB2', 'rVBbOZ1l0xbc7dXjezVpU5BgmgC2'];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ====================== USER PROFILES ======================
    match /userProfiles/{userId} {
      allow read: if request.auth != null && (isOwner(userId) || isCoach(request.auth.uid));
      allow write: if request.auth != null && isOwner(userId);
    }

    // ====================== CHAT METADATA ======================
    match /user_chat_metadata/{metadataId} {
      allow read, write: if request.auth != null && (request.auth.uid == metadataId.split('_')[0] || isCoach(request.auth.uid));
      allow list: if request.auth != null && isCoach(request.auth.uid);
    }

    // ====================== CLIENTS & SUBCOLLECTIONS ======================
    match /clients/{clientId} {
      allow list, read: if request.auth != null && (isOwner(clientId) || isCoach(request.auth.uid));
      allow create, update: if request.auth != null && isOwner(clientId);
      allow delete: if request.auth != null && isCoach(request.auth.uid);
      match /{document=**} {
        allow read, write: if request.auth != null && (isOwner(clientId) || isCoach(request.auth.uid));
      }
    }

    // ====================== CHALLENGES ======================
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ====================== INDULGENCE PLANS ======================
    match /indulgencePlans/{indulgencePlanId} {
      allow read, write: if request.auth != null && isOwner(resource.data.userId);
    }

    // ====================== CHATS ======================
    match /chats/{chatId} {
      allow get, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow list: if request.auth != null && request.query.where.participants.hasAny([request.auth.uid]);
      match /messages/{messageId} {
        allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ====================== NOTIFICATIONS (SAFE SPLIT) ======================
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (isCoach(request.auth.uid) || (resource != null && isOwner(resource.data.userId)));
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId ||
        isCoach(request.auth.uid)
      );
      allow update, delete: if request.auth != null && resource != null && (
        isOwner(resource.data.userId) || isCoach(request.auth.uid)
      );
    }

    // ====================== APPOINTMENTS (SAFE & NON-BREAKING) ======================
    match /coachCalendar/{appointmentId} {
      // Single document read / get – safe for clients & coaches
      allow read, get: if request.auth != null && resource != null && (
        request.auth.uid == resource.data.clientId ||
        isCoach(request.auth.uid)
      );

      // Allow queries/lists with a reasonable limit (prevents unbounded scans)
      // Combined with the 'read' rule above, this safely allows filtered queries like .where("clientId", "==", uid)
      allow list: if request.auth != null &&
                    request.query.limit <= 50 &&  // Adjust limit as needed (e.g., 100)
                    request.query.limit > 0;     // Prevent no-limit queries

      // Write (unchanged)
      allow write: if request.auth != null && (
        (isOwner(resource.data.clientId) && request.auth.uid == resource.data.clientId) ||
        (isCoach(request.auth.uid) && request.auth.uid == resource.data.coachId)
      );
    }
  }
}