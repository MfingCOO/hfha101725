rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isCoach(userId) {
      // a coach user can be added here
      return userId in ['yue7fVPBQZg45vmfXXUH5PdG7jE2', 'oYsf7Iah6hVlEgHvWJ7Ms7j1oTB2'];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function canUpdateFcmTokens() {
      // Allow updating only the fcmTokens field
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId);

      match /privateData/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /clients/{clientId} {
      allow read: if isOwner(clientId) || isCoach(request.auth.uid);

      // Allow a client to CREATE and UPDATE their own document.
      // This allows setDoc with {merge: true} to work for new users creating their doc,
      // and for existing users updating their fcmTokens.
      allow create, update: if isOwner(clientId);

      // Coaches have broader permissions.
      allow list, write, delete: if isCoach(request.auth.uid);

      match /journal/{journalId} {
        allow read: if isOwner(clientId) || isCoach(request.auth.uid);
        allow create, update, delete: if isOwner(clientId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(clientId) || isCoach(request.auth.uid);
        allow create, update, delete: if isOwner(clientId);

        match /subTasks/{subTaskId} {
          allow read: if isOwner(clientId) || isCoach(request.auth.uid);
          allow create, update, delete: if isOwner(clientId);
        }
      }

      match /appointments/{appointmentId} {
        allow read: if isOwner(clientId) || isCoach(request.auth.uid);
        allow create, update, delete: if isOwner(clientId);
      }

      match /nudges/{nudgeId} {
        allow read: if isOwner(clientId) || isCoach(request.auth.uid);
        allow create, update, delete: if isOwner(clientId);
      }

      match /macros/{macroId} {
        allow read, list: if isOwner(clientId) || isCoach(request.auth.uid);
        allow create, update, delete: if isOwner(clientId);
        allow write: if isCoach(request.auth.uid);
      }
    }

    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
