
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is a coach
    function isCoach(userId) {
      // Alan and Crystal's UIDs
      return userId in ['yue7fVPBQZg45vmfXXUH5PdG7jE2', 'oYsf7Iah6hVlEgHvWJ7Ms7j1oTB2'];
    }

    // Lock down asset library to coaches only
    match /asset-library/{docId} {
        allow read: if request.auth != null;
        allow write: if isCoach(request.auth.uid);
    }

    // Coaches can manage challenges
    match /challenges/{challengeId} {
        allow read: if request.auth != null;
        allow write: if isCoach(request.auth.uid);
    }
    
    // Coaches can manage popups
    match /popups/{popupId} {
      allow read, write: if isCoach(request.auth.uid);
    }

    // CORRECTED RULE: Users can read and update their own scheduled reminders/pop-ups
    match /user_scheduled_reminders/{reminderId} {
      allow read, update: if request.auth.uid == resource.data.userId;
    }

    // Users can read and write their own sticky-popups
    match /sticky-popups/{popupId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    // User profiles can be read by any authenticated user.
    // They can only be created/updated by their owner.
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Clients collection can be read/written by coaches
    // Individual client docs can be read by their owner.
    match /clients/{clientId} {
      allow read: if request.auth.uid == clientId || isCoach(request.auth.uid);
      allow list, write: if isCoach(request.auth.uid);
      
      // All client sub-collections can be read by the owner or a coach
      // and written to by the owner. Coaches get write access via admin SDK.
      match /{collection}/{docId} {
        allow read: if request.auth.uid == clientId || isCoach(request.auth.uid);
        allow create, update, delete: if request.auth.uid == clientId;
      }
    }
    
    // Chats can be accessed by participants or any coach.
    match /chats/{chatId} {
      allow read: if isCoach(request.auth.uid) || request.auth.uid in resource.data.participants;
      allow write: if request.auth.uid in resource.data.participants;

      // Messages can be read by participants or any coach.
      // Messages can be created by participants.
      match /messages/{messageId} {
        allow read: if isCoach(request.auth.uid) || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
