rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Allow users to update their own fcmTokens array.
    // This is crucial for push notifications to work.
    function canUpdateFcmTokens() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);
    }

    // Rules for Client documents
    match /clients/{userId} {
      // A user can create their own client document
      allow create: if isOwner(userId);
      
      // A user can read their own document. A coach can read their assigned client's document.
      allow read: if isOwner(userId) || (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.clients[userId] == true);
      
      // A user can update their own document if they are the owner and only updating fcmTokens
      allow update: if isOwner(userId) && canUpdateFcmTokens();
    }

    // Rules for Coach (userProfiles) documents
    match /userProfiles/{userId} {
      // A user can create their own profile
      allow create: if isOwner(userId);
      
      // A user can read their own profile.
      allow read: if isOwner(userId);

      // A user can update their own document if they are the owner and only updating fcmTokens
      allow update: if isOwner(userId) && canUpdateFcmTokens();
    }

    // All other collections/documents are locked down by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
