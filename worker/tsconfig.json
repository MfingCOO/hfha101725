{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ESNext",
      "WebWorker",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "index.ts"
  ]
}
